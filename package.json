{
  "name": "oikome",
  "private": true,
  "license": "Apache-2.0",
  "description": "Oikome's JavaScript workspaces: the web app, its packages and the end-to-end tests",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspace @oikome/e2e"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
